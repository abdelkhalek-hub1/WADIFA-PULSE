# ==========================================
# 1. Base de données PostgreSQL / Supabase
# ==========================================
# Optionnel: Si vide, l'application utilise une base SQLite locale (wadifa_local.db)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Clé secrète Flask pour les sessions (générer une clé aléatoire en production)
SECRET_KEY=generate-a-secure-random-key-here

# ==========================================
# 2. Notifications Telegram Bot
# ==========================================
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# ==========================================
# 3. Notifications Email (Gmail SMTP)
# ==========================================
EMAIL_ENABLED=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
EMAIL_SENDER=votre.email@gmail.com
EMAIL_PASSWORD=abcd efgh ijkl mnop
EMAIL_RECIPIENT=votre.email@gmail.com

# ==========================================
# 4. Synchronisation Google Sheets (Apps Script Webhook)
# ==========================================
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec

